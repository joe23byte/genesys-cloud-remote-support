# Remote Support for Genesys Cloud – configuration
# Copy to ".env" (local start and docker compose read it automatically).
# Every variable is optional in development; production requirements are noted.

# --- Server ------------------------------------------------------------------
# "production" enables HTTPS enforcement, HSTS and strict validation.
NODE_ENV=development
PORT=3000
# HOST=0.0.0.0

# Public URL as seen by browsers (https required in production). Used for invite
# links, the WebSocket origin check and CSP. On Render it defaults to RENDER_EXTERNAL_URL.
# PUBLIC_BASE_URL=https://remote-support.example.com

# Number of reverse-proxy hops to trust for X-Forwarded-* (production default: 1).
# TRUST_PROXY=1
# Header with the real client IP set by an edge proxy that overwrites it (Render/Cloudflare:
# cf-connecting-ip). Only set this when ALL traffic passes that proxy.
# CLIENT_IP_HEADER=cf-connecting-ip
# Redirect http -> https (default: true in production; /api/health is exempt).
# FORCE_HTTPS=true
# Optional direct TLS without a proxy (e.g. test on a LAN machine):
# HTTPS_CERT_FILE=./certs/cert.pem
# HTTPS_KEY_FILE=./certs/key.pem

# --- Secrets & storage -------------------------------------------------------
# REQUIRED in production, at least 32 characters. Generate: npm run secret:generate
# Used for session-code lookup HMACs, TURN credentials and IP hashing in the audit log.
# SERVER_SECRET=

# SQLite file (directory is created automatically).
# DATABASE_PATH=./data/remote-support.sqlite

# --- Agent accounts (PoC login, independent of Genesys) ----------------------
# REQUIRED in production. Format per account: id|Display Name|password-hash
# Multiple accounts separated by ";" or new lines. Create entries with: npm run agent:create
# AGENT_ACCOUNTS=anna|Anna Agent|scrypt:16384:8:1:...:...;ben|Ben Agent|scrypt:16384:8:1:...:...
#
# Development only: without AGENT_ACCOUNTS a user "demo" is created. Fixed password:
# DEV_AGENT_PASSWORD=choose-a-dev-password
# AGENT_TOKEN_TTL_HOURS=10

# --- Session lifetime --------------------------------------------------------
# INVITE_TTL_SECONDS=600
# SESSION_MAX_DURATION_MINUTES=120
# SESSION_IDLE_TIMEOUT_MINUTES=15
# METADATA_RETENTION_DAYS=30

# --- Genesys Cloud embedding -------------------------------------------------
# Allowed gcHostOrigin values AND CSP frame-ancestors for /agent. When set, this list
# REPLACES the defaults (all public regions: apps.mypurecloud.com/.ie/.de/.com.au/.jp,
# https://*.pure.cloud, https://*.us-gov-pure.cloud). Comma separated, "*." prefix allowed.
# GC_ALLOWED_HOST_ORIGINS=https://apps.mypurecloud.de,https://apps.euc2.pure.cloud
# Additional frame-ancestors only (no gcHostOrigin), e.g. a later Salesforce embedding:
# FRAME_ANCESTORS_EXTRA=https://*.lightning.force.com

# --- WebRTC / ICE ------------------------------------------------------------
# STUN servers (comma separated). "none" disables STUN.
# STUN_URLS=stun:stun.l.google.com:19302
# TURN servers (comma separated). Use either TURN_SECRET (coturn use-auth-secret,
# recommended) or static TURN_USERNAME/TURN_PASSWORD.
# TURN_URLS=turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
# TURN_SECRET=
# TURN_USERNAME=
# TURN_PASSWORD=
# TURN_CREDENTIAL_TTL_SECONDS=14400
# "relay" = TURN-only mode for all sessions (agents can also force it per session).
# ICE_TRANSPORT_POLICY=all

# Capture limits for the customer's screen
# MEDIA_MAX_WIDTH=1920
# MEDIA_MAX_HEIGHT=1080
# MEDIA_MAX_FPS=15
# MEDIA_MAX_BITRATE_KBPS=2500

# --- Session-end webhook (preparation for Salesforce or other systems) -------
# POSTs session metadata as JSON when a session ends, signed with HMAC-SHA256.
# The secret is REQUIRED in production when a URL is configured.
# SESSION_END_WEBHOOK_URL=https://example.com/hooks/remote-support
# SESSION_END_WEBHOOK_SECRET=
# WEBHOOK_TIMEOUT_MS=10000

# --- Optional Genesys Cloud Platform API (read-only) -------------------------
# OAuth client (grant type Client Credentials) with a role containing only
# Conversation > Communication > View for the divisions of the relevant queues.
# Only used to READ a conversation (GET /api/v2/conversations/{id}); nothing is modified.
# GENESYS_API_ENABLED=false
# GENESYS_API_REGION=mypurecloud.de
# GENESYS_CLIENT_ID=
# GENESYS_CLIENT_SECRET=
# Reject session creation when the conversation cannot be read or its host does not match.
# GENESYS_VERIFY_CONVERSATION=false

# --- Misc --------------------------------------------------------------------
# LOGIN_RATE_LIMIT=10
# CODE_JOIN_RATE_LIMIT=10
# DEMO_ENABLED=true
# AUDIT_LOG_STDOUT=true
# LOG_LEVEL=info

# --- docker compose only -----------------------------------------------------
# APP_PORT=3000
# PUBLIC_DOMAIN=remote-support.example.com
# TURN_REALM=remote-support.example.com
# TURN_EXTERNAL_IP=203.0.113.10
